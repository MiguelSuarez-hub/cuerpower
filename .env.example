# Base de datos
# Local (docker-compose): postgresql://cuerpower:cuerpower@localhost:5433/cuerpower
# Producción (Neon): copia la connection string desde el dashboard de Neon (usa el pooled connection string)
DATABASE_URL="postgresql://cuerpower:cuerpower@localhost:5433/cuerpower"

# Auth.js
# Genera uno con: npx auth secret
AUTH_SECRET=""

# Vercel Blob (evidencia de actividades)
# Se genera automáticamente al crear/vincular el Blob store con `vercel blob create-store`
BLOB_READ_WRITE_TOKEN=""
